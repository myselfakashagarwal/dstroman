#!/bin/bash

check_and_install_dependencies() { 
  PACKAGE_MANAGER=""
  if command -v yum > /dev/null 2>&1; then
      PACKAGE_MANAGER="yum"
  elif command -v apt-get > /dev/null 2>&1; then
      PACKAGE_MANAGER="apt"
  else
    echo "ERROR Unsupported package manager"
    exit 1;  
  fi
  
  touch ~/dstroman.log

  if [[ $PACKAGE_MANAGER == "apt" ]]; then
    echo "INFO Updating apt package lists"
    sudo apt update
  fi

  confirm() {
    local prompt="$1"
    if [[ ! -t 0 ]]; then
      echo "$prompt (y/n): non-interactive shell detected, defaulting to 'y'"
      echo "y"
    else
      read -p "$prompt (y/n): " choice
      echo "$choice"
    fi
  }
  
  if command -v wget > /dev/null 2>&1; then
    echo "wget is installed"
  else
    choice=$(confirm "Procceed with installation of 'wget'")
    if [[ $choice == "y" ]]; then
      echo "INFO Installing 'wget'" 
      sudo $PACKAGE_MANAGER install -y wget
      if command -v wget > /dev/null 2>&1; then
        echo "INFO 'wget' installed successfully"
      else
        echo "ERROR 'wget' installation failed check logs at '~/dstroman.log'"
        exit 1
      fi
    else
      echo "FATAL 'wget' not installed, its is required for the script to run"
      exit 1
    fi
  fi
  
  if command -v gum > /dev/null 2>&1; then
    echo "gum is installed"
    else
      choice=$(confirm "Proceed with installation of 'gum'?")
      if [[ $choice == "y" ]]; then
        echo "INFO Installing 'gum'" 
        cd $HOME
        wget https://github.com/charmbracelet/gum/releases/download/v0.16.1/gum_0.16.1_Linux_x86_64.tar.gz
        tar -xzf ~/gum_0.16.1_Linux_x86_64.tar.gz
        sudo mv ~/gum_0.16.1_Linux_x86_64/gum /usr/local/bin/gum
        sudo chmod +x /usr/local/bin/gum
        sudo rm ~/gum_0.16.1_Linux_x86_64.tar.gz
        sudo rm -rf ~/gum_0.16.1_Linux_x86_64
        if command -v gum > /dev/null 2>&1; then
          gum log --level info "'gum' installed successfully"
        else
          echo "ERROR 'gum' installation failed check logs at '~/dstroman.log'"
          exit 1
        fi
      else 
        echo "FATAL 'gum' not installed, its required for the script to run"
        exit 1;
      fi
  fi
  
  if command -v which > /dev/null 2>&1; then
    echo "which is installed"
  else
    choice=$(confirm "Proceed with installation of 'which'?")
    if [[ $choice == "y" ]]; then
      gum log --level info "Installing 'which'"
      sudo $PACKAGE_MANAGER install -y which
      if command -v which > /dev/null 2>&1; then
        gum log --level info "'which' installed successfully"
      else
        gum log --level error "'which' installation failed check logs at '~/dstroman.log'"
        exit 1
      fi
    else
      gum log --level fatal "'which' not installed, its is required for the script to run"
      exit 1
    fi
  fi
  
  
  if [[ ! -x $(which docker 2>/dev/null) ]]; then
    choice=$(confirm "Docker is not installed, proceed with installation of docker?")
    if [[ $choice == "y" ]]; then
        if [[ $PACKAGE_MANAGER == "apt" ]]; then
            gum log --level info "Installing Docker"
            sudo $PACKAGE_MANAGER install -y docker.io docker-compose
            if command -v docker > /dev/null 2>&1; then
              gum log --level info "Docker installed successfully"
            else
              gum log --level error "Docker installation failed check logs at '~/dstroman.log'"
              exit 1
            fi
            gum log --level info "Adding user to docker group"
            getent group docker > /dev/null 2>&1 || sudo groupadd docker
            sudo usermod -aG docker $USER
            gum log --level info "User added to docker group successfully"
            gum log --level info "Enabling Docker service"
            sudo systemctl enable docker
            gum log --level info "Docker service enabled successfully"
            gum log --level info "Starting Docker service"
            sudo systemctl start docker
            if sudo systemctl is-active docker; then
              gum log --level info "Docker service started successfully"
            else
              gum log --level error "Docker service failed to start"
              exit 1
            fi
            gum log --level warn "After installation is complete, please log out and log back in to apply the changes."
        elif [[ $PACKAGE_MANAGER == "yum" ]]; then
            gum log --level info "Updating system"
            sudo yum update
            sudo yum install -y yum-utils device-mapper-persistent-data lvm2
            gum log --level info "System updated successfully"
            gum log --level info "Installing Docker"
            sudo yum-config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
            sudo yum install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin --allowerasing
            if command -v docker > /dev/null 2>&1; then
              gum log --level info "Docker installed successfully"
            else
              gum log --level error "Docker installation failed"
              exit 1
            fi
            gum log --level info "Adding user to docker group"
            getent group docker > /dev/null 2>&1 || sudo groupadd docker
            sudo usermod -aG docker $USER
            gum log --level info "User added to docker group successfully"
            gum log --level info "Enabling Docker service"
            sudo systemctl enable docker
            gum log --level info "Docker service enabled successfully"
            gum log --level info "Starting Docker service"
            sudo systemctl start docker
            if sudo systemctl is-active docker; then
              gum log --level info "Docker service started successfully"
            else
              gum log --level error "Docker service failed to start"
              exit 1
            fi
            gum log --level warn "After installation is complete, please log out and log back in to apply the changes." 
        fi
    else
      gum log --level fatal "Docker not installed, please install it for using the script"
      exit 1
    fi
  fi
  
  if [[ ! -e ~/.config/dstroman/backups ]]; then 
    gum log --level info "Creating backups directory"
    mkdir -p ~/.config/dstroman/backups 
    gum log --level info "Backups directory created successfully"
  fi

  if [[ ! -e ~/.config/dstroman/editor ]]; then
    gum log --level info "Creating editor configuration file"
    touch ~/.config/dstroman/editor
    echo "echo" >  ~/.config/dstroman/editor
    gum log --level warn "Editor configuration file created successfully; by default it will echo the file path please edit it"
  fi 

} 

mac_check_dependencies() {
  [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
  export PATH="$HOME/.orbstack/bin:/usr/local/bin:$PATH"

  touch ~/dstroman.log

  if ! command -v gum > /dev/null 2>&1; then
    if ! command -v brew > /dev/null 2>&1; then
      echo "FATAL Homebrew is required to install 'gum' (https://brew.sh)"
      exit 1
    fi
    read -p "Proceed with installation of 'gum'? (y/n): " choice
    if [[ $choice == "y" ]]; then
      brew install gum || { echo "ERROR 'gum' installation failed"; exit 1; }
    else
      echo "FATAL 'gum' not installed, its required for the script to run"
      exit 1
    fi
  fi

  if ! command -v docker > /dev/null 2>&1; then
    gum log --level fatal "Docker not found. Install OrbStack (brew install --cask orbstack), open it once, then re-run"
    exit 1
  fi

  if ! docker info > /dev/null 2>&1; then
    command -v orb > /dev/null 2>&1 && orb start > /dev/null 2>&1
    if ! docker info > /dev/null 2>&1; then
      gum log --level error "Docker isn't reachable, start OrbStack (open -a OrbStack) and re-run"
      exit 1
    fi
  fi

  if [[ ! -e ~/.config/dstroman/backups ]]; then
    gum log --level info "Creating backups directory"
    mkdir -p ~/.config/dstroman/backups
    gum log --level info "Backups directory created successfully"
  fi

  if [[ ! -e ~/.config/dstroman/editor ]]; then
    gum log --level info "Creating editor configuration file"
    mkdir -p ~/.config/dstroman
    echo "echo" > ~/.config/dstroman/editor
    gum log --level warn "Editor configuration file created successfully; by default it will echo the file path please edit it"
  fi
}

if [[ $(uname -s) == "Darwin" ]]; then
  mac_check_dependencies
else
  check_and_install_dependencies
fi

# later in working must be taken form initrial setup config 
open_editor() {
  sudo $(cat ~/.config/dstroman/editor) $1;
}

# path validator for gum bug (-z sucked)
validate_empty() {
  if [[ $1 == ""  ]]; then
    exit 1;
  fi
}

# gum's file picker fails with "error entering raw mode: interrupted system call"
# when it is launched through sudo. Browse as the current user when the directory
# is readable and only elevate when root access is actually required.
gum_file() {
  local dir="${1:-$PWD}"
  if [[ -r "$dir" && -x "$dir" ]]; then
    gum file --padding "1 0 0 0" "$dir"
  else
    sudo "$(command -v gum)" file --padding "1 0 0 0" "$dir"
  fi
}

# check for existing containers 
is_exists_container() {
  if [[ $(docker ps | wc -l ) -eq 1 ]]; then
    gum log --level warn "No containers found"
    exit 1;
  fi
}

# check for existing volume 
is_exists_volume() {
  if [[ $(docker volume ls | wc -l) -eq 1 ]]; then 
    gum log --level warn "No volumes found"
    exit 1;
  fi
}

# check for existing bind mounts 
is_exists_bind() {
  if [[ $(docker ps | awk 'NR!=1{ print $1 }' | xargs docker inspect --format "{{with .Mounts}}{{range .}}{{$.ID}} {{$.Name}} {{.Source}} {{.Destination}}{{end}}{{end}}" 2> /dev/null | awk 'NF' | wc -l) -eq 0 ]]; then
    gum log --level warn "No bind mounts found"
    exit 1
  fi
}

# Helper function: selecting the volume 
select_volume() {
  docker volume ls | awk 'NR!=1{ print }' | gum choose | awk '{ print $2 }' | xargs docker inspect --format {{.Mountpoint}} 2> /dev/null  | xargs echo 
} 

# Helper function: selecting the bind 
select_bind() {
  docker ps | awk 'NR!=1{ print $1 }' | xargs docker inspect --format "{{with .Mounts}}{{range .}}{{$.ID}} {{$.Name}} {{.Source}} {{.Destination}}{{end}}{{end}}" | awk 'NF' | gum choose | awk '{ print $3 }' | xargs echo 
}

# Helper function: selecting the container
# Helper function: selecting the container 
select_container() {
  local CONTAINER_ID=$(docker ps | awk 'NR!=1{ print }' | gum choose | awk '{ print $1 }')
  if [[ -z "$CONTAINER_ID" ]]; then
    return 1
  fi
  
  # Try GraphDriver.Data.MergedDir first (overlay2/overlayfs)
  local MERGED_DIR=$(docker inspect "$CONTAINER_ID" --format '{{.GraphDriver.Data.MergedDir}}' 2>/dev/null)
  
  # If that doesn't exist, try UpperDir
  if [[ -z "$MERGED_DIR" || "$MERGED_DIR" == "<no value>" ]]; then
    MERGED_DIR=$(docker inspect "$CONTAINER_ID" --format '{{.GraphDriver.Data.UpperDir}}' 2>/dev/null)
  fi
  
  # If still nothing, try to find it in overlay2 directory
  if [[ -z "$MERGED_DIR" || "$MERGED_DIR" == "<no value>" ]]; then
    local DRIVER=$(docker inspect "$CONTAINER_ID" --format '{{.Driver}}' 2>/dev/null)
    if [[ "$DRIVER" == "overlay2" || "$DRIVER" == "overlayfs" ]]; then
      MERGED_DIR=$(find /var/lib/docker/overlay2 -maxdepth 2 -name "merged" -type d 2>/dev/null | head -1)
    fi
  fi
  
  # Last resort: use container's data directory
  if [[ -z "$MERGED_DIR" || "$MERGED_DIR" == "<no value>" ]]; then
    FULL_ID=$(docker ps --no-trunc --format '{{.ID}}' | grep $CONTAINER_ID )
    MERGED_DIR="/var/lib/docker/rootfs/overlayfs/$FULL_ID"
  fi
   echo "$MERGED_DIR" 
}

# Helper function: select container file   
select_container_file() {  
  local SELECTED_CONTAINER=$(select_container);
  validate_empty "$SELECTED_CONTAINER"
  gum_file "$SELECTED_CONTAINER"
}

# Helper function: select host file
select_host_file() {
  gum_file "${1:-$PWD}" | xargs echo 
}

# Helper function: select bind mount file 
select_bind_file() {
  docker ps | awk 'NR!=1{ print $1 }' | xargs docker inspect --format "{{with .Mounts}}{{range .}}{{$.ID}} {{$.Name}} {{.Source}} {{.Destination}}{{end}}{{end}}" | awk 'NF' | gum choose | awk '{ print $3 }' | while read path; do [[ -d "$path" ]] && gum_file "$path" || echo "$path"; done | xargs echo 
}

# Helper function: select volume file 
select_volume_file() {
   local SELECTED_VOLUME=$(select_volume)
   local -a LS_CMD=(ls -A)
   validate_empty "$SELECTED_VOLUME"
   [[ -r "$SELECTED_VOLUME" && -x "$SELECTED_VOLUME" ]] || LS_CMD=(sudo ls -A)
   if [[ $("${LS_CMD[@]}" "$SELECTED_VOLUME" | wc -l) -eq 0 ]]; then 
     echo "$SELECTED_VOLUME"
   else 
     gum_file "$SELECTED_VOLUME" | xargs echo 
   fi
}

select_object_file() {
  local SELECTED_OBJECT_TYPE=$(gum choose "Container" "Volume" "Bind" "Host" "Exit")
  if [[ $SELECTED_OBJECT_TYPE == "Container" ]]; then
      local SELECTED_OBJECT_FILE=$(is_exists_container && select_container_file | xargs echo)
      echo "$SELECTED_OBJECT_FILE"
      # validate_empty "$SELECTED_OBJECT_FILE" && echo "$SELECTED_OBJECT_FILE"
      exit 0
  elif [[ $SELECTED_OBJECT_TYPE == "Volume" ]]; then
      local SELECTED_OBJECT_FILE=$(is_exists_volume && select_volume_file | xargs echo)
      validate_empty "$SELECTED_OBJECT_FILE" && echo "$SELECTED_OBJECT_FILE"
      exit 0
  elif [[ $SELECTED_OBJECT_TYPE == "Bind" ]]; then
      local SELECTED_OBJECT_FILE=$(is_exists_bind && select_bind_file | xargs echo)
      validate_empty "$SELECTED_OBJECT_FILE" && echo "$SELECTED_OBJECT_FILE"
      exit 0
  elif [[ $SELECTED_OBJECT_TYPE == "Exit" ]]; then
      echo "exit manually"
      exit 0
  elif [[ $SELECTED_OBJECT_TYPE == "Host" ]]; then
      local SELECTED_OBJECT_FILE=$(select_host_file | xargs echo)
      validate_empty "$SELECTED_OBJECT_FILE" && echo "$SELECTED_OBJECT_FILE"
      exit 0
  else 
      exit 0
  fi
}

select_object() {
  local SELECTED_OBJECT_TYPE=$(gum choose "Container" "Volume" "Bind" "Exit")
  if [[ $SELECTED_OBJECT_TYPE == "Container" ]]; then
      local SELECTED_OBJECT_FILE=$(is_exists_container && select_container | xargs echo)
      validate_empty "$SELECTED_OBJECT_FILE" && echo "$SELECTED_OBJECT_FILE"
      exit 0
  elif [[ $SELECTED_OBJECT_TYPE == "Volume" ]]; then
      local SELECTED_OBJECT_FILE=$(is_exists_volume && select_volume | xargs echo)
      validate_empty "$SELECTED_OBJECT_FILE" && echo "$SELECTED_OBJECT_FILE"
      exit 0
  elif [[ $SELECTED_OBJECT_TYPE == "Bind" ]]; then
      local SELECTED_OBJECT_FILE=$(is_exists_bind && select_bind | xargs echo)
      validate_empty "$SELECTED_OBJECT_FILE" && echo "$SELECTED_OBJECT_FILE"
      exit 0
  elif [[ $SELECTED_OBJECT_TYPE == "Exit" ]]; then
      echo "Exited manually"
      exit 0
  else 
      exit 0
  fi
}

input_name() {
  local NAME=""
  until [[ "$NAME" =~ ^[a-zA-Z0-9]+$ ]]; do
    read -p "Enter alphanumeric name for backup file " NAME
    [[ "$NAME" =~ ^[a-zA-Z0-9]+$ ]] || echo "Invalid input. Only letters and numbers are allowed."
  done
  echo "$NAME"
}


if [[ $(uname -s) == "Darwin" ]]; then
  ORB_ROOT="$HOME/OrbStack/docker"

  select_container() {
    local CONTAINER_ID=$(docker ps | awk 'NR!=1{ print }' | gum choose | awk '{ print $1 }')
    if [[ -z "$CONTAINER_ID" ]]; then
      return 1
    fi
    local CONTAINER_NAME=$(docker inspect --format '{{.Name}}' "$CONTAINER_ID" | sed 's#^/##')
    echo "$ORB_ROOT/containers/$CONTAINER_NAME"
  }

  select_volume() {
    local VOLUME_NAME=$(docker volume ls | awk 'NR!=1{ print }' | gum choose | awk '{ print $2 }')
    if [[ -z "$VOLUME_NAME" ]]; then
      return 1
    fi
    echo "$ORB_ROOT/volumes/$VOLUME_NAME"
  }
fi

# multi-select with visible [x] / [ ] checkboxes (Space or x toggles, Enter confirms)
ds_multi_choose() {
  gum choose --no-limit --height 20 \
    --cursor "> " --cursor-prefix "[ ] " --selected-prefix "[x] " --unselected-prefix "[ ] " \
    --header "$1"
}

# pads tab-separated rows into aligned columns
ds_pad_table() {
  awk -F'\t' '
    { for (i = 1; i <= NF; i++) { c[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } if (NF > nf) nf = NF }
    END {
      for (r = 1; r <= NR; r++) {
        line = ""
        for (i = 1; i <= nf; i++) line = line sprintf("%-" w[i] "s  ", c[r, i])
        sub(/ +$/, "", line)
        print line
      }
    }'
}

# ds_check_pick <gum exit code> <selection>: never fail silently
ds_check_pick() {
  [[ $1 -eq 130 ]] && exit 0
  [[ $1 -eq 0 ]] || { gum log --level error "gum choose failed (exit $1)"; exit 1; }
  [[ -n $2 ]] || { gum log --level warn "Nothing checked. Toggle rows with Space (or x), then press Enter"; exit 0; }
}

# ds_ask "question" -> default answer is No
ds_ask() {
  gum confirm --default=false "$1"
}

# dstroman kill: multi-select containers / compose projects, force-remove them
ds_kill() {
  local menu raw kind selected line name targets="" projects="" count running rm_flags="-f" rm_vols=0 p net vol

  raw=$(docker ps -a --format '{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Label "com.docker.compose.project"}}')
  [[ -n $raw ]] || { gum log --level warn "No containers found"; exit 0; }

  # Columns: KIND  NAME  IMAGE  STATUS  PROJECT. "compose" rows act on the whole project.
  menu=$(
    {
      printf '%s\n' "$raw" | awk -F'\t' '$4 != "" { c[$4]++ } END { for (p in c) printf "compose\t%s\t(whole project)\t%d container(s)\t-\n", p, c[p] }' | sort
      printf '%s\n' "$raw" | awk -F'\t' '{ printf "container\t%s\t%s\t%s\t%s\n", $1, $2, $3, ($4 == "" ? "-" : $4) }'
    } | ds_pad_table
  )

  selected=$(printf '%s\n' "$menu" \
    | ds_multi_choose "Space or x = check, Enter = confirm. 'compose' rows remove the whole project")
  ds_check_pick $? "$selected"

  while IFS= read -r line; do
    read -r kind name _ <<< "$line"
    case $kind in
      compose)
        projects="$projects$name"$'\n'
        targets="$targets$(docker ps -a --filter "label=com.docker.compose.project=$name" --format '{{.Names}}')"$'\n'
        ;;
      container)
        targets="$targets$name"$'\n'
        ;;
    esac
  done <<< "$selected"

  targets=$(printf '%s' "$targets" | awk 'NF' | sort -u)
  projects=$(printf '%s' "$projects" | awk 'NF' | sort -u)
  [[ -n $targets ]] || { gum log --level warn "Nothing selected"; exit 0; }

  count=$(printf '%s\n' "$targets" | wc -l | tr -d ' ')
  running=$(docker ps --format '{{.Names}}' | grep -Fxf <(printf '%s\n' "$targets") | wc -l | tr -d ' ')

  gum log --level warn "About to FORCE-REMOVE $count container(s) ($running running, they will be SIGKILLed):"
  sed 's/^/    - /' <<< "$targets"
  ds_ask "Force kill and remove these $count container(s)? This cannot be undone." || exit 0

  ds_ask "Also remove anonymous volumes attached to them?" && rm_flags="-fv"
  if [[ -n $projects ]]; then
    ds_ask "Also delete the NAMED volumes of the selected compose project(s)? (data loss)" && rm_vols=1
  fi

  while IFS= read -r name; do
    if docker rm $rm_flags -- "$name" > /dev/null; then
      gum log --level info "Removed $name"
    else
      gum log --level error "Failed to remove $name"
    fi
  done <<< "$targets"

  # compose leftovers: networks (and optionally named volumes) labelled with the project
  while IFS= read -r p; do
    [[ -n $p ]] || continue
    for net in $(docker network ls -q --filter "label=com.docker.compose.project=$p"); do
      if docker network rm "$net" > /dev/null 2>&1; then
        gum log --level info "Removed network $net of project '$p'"
      else
        gum log --level warn "Could not remove network $net of project '$p' (still in use?)"
      fi
    done
    if [[ $rm_vols -eq 1 ]]; then
      for vol in $(docker volume ls -q --filter "label=com.docker.compose.project=$p"); do
        if docker volume rm "$vol" > /dev/null 2>&1; then
          gum log --level info "Removed volume $vol"
        else
          gum log --level warn "Could not remove volume $vol (still in use?)"
        fi
      done
    fi
  done <<< "$projects"
}

ds_run_prune() {
  case $1 in
    "Stopped containers")               docker container prune -f ;;
    "Dangling images")                  docker image prune -f ;;
    "All unused images")                docker image prune -a -f ;;
    "Unused networks")                  docker network prune -f ;;
    "Build cache (unused)")             docker builder prune -f ;;
    "Build cache (everything)")         docker builder prune -a -f ;;
    "Anonymous volumes (unused)")       docker volume prune -f ;;
    "All unused volumes"*)              docker volume prune -a -f ;;
    "System ("*)                        docker system prune -f ;;
    "EVERYTHING"*)                      docker system prune -a -f && docker volume prune -a -f ;;
  esac
}

# dstroman prune: choose what to prune
ds_prune() {
  local selected line danger=0
  local -a items=(
    "Stopped containers"
    "Dangling images"
    "All unused images"
    "Unused networks"
    "Build cache (unused)"
    "Build cache (everything)"
    "Anonymous volumes (unused)"
    "All unused volumes (incl. named)"
    "System (containers, networks, dangling images, build cache)"
    "EVERYTHING unused (system -a + all unused volumes)"
  )

  docker system df
  selected=$(printf '%s\n' "${items[@]}" \
    | ds_multi_choose "Space or x = check, Enter = confirm")
  ds_check_pick $? "$selected"

  gum log --level warn "Selected:"
  sed 's/^/    - /' <<< "$selected"
  while IFS= read -r line; do
    case $line in "All unused volumes"*|"EVERYTHING"*) danger=1 ;; esac
  done <<< "$selected"

  ds_ask "Run the selected prune operations?" || exit 0
  if [[ $danger -eq 1 ]]; then
    ds_ask "This also deletes NAMED volumes that no container uses (data loss). Really continue?" || exit 0
  fi

  while IFS= read -r line; do
    gum log --level info "Pruning: $line"
    ds_run_prune "$line" || gum log --level error "Prune failed: $line"
  done <<< "$selected"

  docker system df
}

####################################################################################################################################
# Evaluating all options and arguments 
NUMBER_OF_ARGUMENTS=$#
if [[ $NUMBER_OF_ARGUMENTS -eq 0 ]]; then
  echo "NO ARGUMENT PASSED...."
  exit 0
else
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --init)
          gum log --level info "You are ready to go!"
          exit 0
      ;;
      --help)
          echo "

          $> dstroman [OPTION] [ARGUMENT]

          OPTION/FLAG         ARGUMENT        USECASE   
          --init              <none>          To install dependencies & initialize configuration   
          --navigate          <none>          To edit traverse docker objects's file system 
          --transfer          <none>          To transfer files in between docker objects
          --list-backups      <none>          List all the backups 
          --create-backup     <none>          To create backup of object like container or object files 
          --remove-backup     <none>          To delete backup
          --kill              <none>          To select containers (and compose projects), force kill & remove them
          --prune             <none>          To choose what to prune (networks, build cache, volumes, system ...)

          "
          exit 0;
      ;;
      --navigate)
	        SELECTED_OBJECT_FILE=$(select_object_file);
	        validate_empty $SELECTED_OBJECT_FILE
	        open_editor $SELECTED_OBJECT_FILE
          exit 0
      ;;
      --transfer) 
          SELECTED_TRANSFER_TYPE=$(gum choose "Copy" "Move" "Exit")
          if [[ $SELECTED_TRANSFER_TYPE == "Copy" ]]; then 
            ACTION="cp -r"
          elif [[ $SELECTED_TRANSFER_TYPE == "Move" ]]; then
            ACTION="mv -r"
          elif [[ $SELECTED_TRANSFER_TYPE == "Exit" ]]; then
            exit 0
          else
            exit 1
          fi
          SELECTED_TRANSFER_SOURCE=$(select_object_file)
          SELECTED_TRANSFER_DESTINATION=$(select_object_file)
          sudo $ACTION "$SELECTED_TRANSFER_SOURCE" "$SELECTED_TRANSFER_DESTINATION"
          exit 0
      ;;
    --list-backups)
          if [[ $(sudo ls -A ~/.config/dstroman/backups | wc -l) -eq 0 ]]; then 
            echo "No backups found"
          else
            ls ~/.config/dstroman/backups
          fi
          exit 0
      ;;
    --create-backup) 
          SELECTED_BACKUP_TYPE=$(gum choose "Object-file" "Object" "Exit")
          if [[ $SELECTED_BACKUP_TYPE == "Object" ]]; then 
            SELECTED_BACKUP_FILE=$(select_object)
          elif [[ $SELECTED_BACKUP_TYPE == "Object-file" ]]; then
            SELECTED_BACKUP_FILE=$(select_object_file)
          elif [[ $SELECTED_BACKUP_TYPE == "Exit" ]]; then
            exit 0
          else
            exit 1
          fi
          validate_empty "$SELECTED_BACKUP_FILE"
          BACKUP_NAME=$(input_name)
          sudo cp -r "$SELECTED_BACKUP_FILE" ~/.config/dstroman/backups/"$BACKUP_NAME"
          exit 0
      ;;
    --remove-backup)  
          if [[ $(sudo ls -A ~/.config/dstroman/backups | wc -l) -eq 0 ]]; then 
            echo "No backups found"
          else
            SELECTED_BACKUP=$(gum choose $(ls  ~/.config/dstroman/backups))
            validate_empty "$SELECTED_BACKUP"
            sudo rm -r ~/.config/dstroman/backups/"$SELECTED_BACKUP"
          fi
          exit 0
      ;;
      kill|--kill)
          ds_kill
          exit 0
      ;;
      prune|--prune)
          ds_prune
          exit 0
      ;;
      *)
        echo "Unknown option: $1"
        shift 
        ;;
    esac
  done
fi
